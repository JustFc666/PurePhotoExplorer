{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PurePhotoExplorer",
  "version": "0.2.0",
  "identifier": "com.purephotoexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PurePhotoExplorer",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#121216",
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../assets/ai/tag/clip_vision.onnx": "assets/ai/tag/clip_vision.onnx",
      "../../../assets/ai/tag/tag_meta.json": "assets/ai/tag/tag_meta.json",
      "../../../assets/ai/tag/text_embeds.bin": "assets/ai/tag/text_embeds.bin",
      "../../../assets/ai/face/yunet.onnx": "assets/ai/face/yunet.onnx",
      "../../../assets/ai/face/sface.onnx": "assets/ai/face/sface.onnx",
      "resources/DirectML.dll": "DirectML.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
